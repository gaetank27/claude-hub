# ============================================================================
# Claude Hub ("system") — example environment configuration.
#
# The backend reads ALL settings from the process environment (see
# internal/config/config.go). There is no built-in .env loader: in production
# these go into a systemd drop-in (see deploy/system-backend.service and the
# .d/auth.conf pattern documented there). This file documents every variable a
# setup wizard should ask for. Copy to a real env file / drop-in and fill in.
#
# Secrets (OIDC client secret, session secret, secret key) MUST be generated
# fresh per install — never reuse the values from any other deployment.
# ============================================================================

# --- Networking -------------------------------------------------------------
# Bind address. Loopback by default; set the LAN IP for VPN access. NEVER 0.0.0.0
# in production — the off-box nginx reverse proxy is the only intended ingress.
SYSTEM_LISTEN=127.0.0.1:8787

# Loopback-only endpoint serving RAG retrieval + tools + ask for the MCP sidecars.
# Must stay on localhost: it is gated only by a per-boot token, never expose it.
SYSTEM_RAG_ADDR=127.0.0.1:8788

# Externally-reachable origin, used to build "open in browser" links to sandbox
# apps behind the /x/ reverse proxy, and as the WS allowed-origin source.
SYSTEM_PUBLIC_BASE_URL=https://claude-hub.example.com

# Extra browser origin hosts accepted on the WebSocket upgrade (comma-separated,
# host only, no scheme). The public host is already derived from the OIDC
# redirect URL; this is for any additional origin.
# SYSTEM_ALLOWED_ORIGINS=hub2.example.com

# --- Storage / paths --------------------------------------------------------
# Base dir for the SQLite DB, append-only journals, sockets, RAG index, RRD,
# secret.key, loopback.token. Created (0700) on first boot. Keep on persistent
# storage — this is the only stateful location besides the project vault.
SYSTEM_DATA_DIR=/home/claude/.local/share/system

# Parent dir under which a new dir-less project's working tree is created.
SYSTEM_PROJECTS_DIR=/home/claude/projects

# Persistent "safe deposit box" for soft-deleted projects (.tar.gz archives).
# Intentionally outside DATA_DIR and never auto-purged.
SYSTEM_VAULT_DIR=/home/claude/project-vault

# Absolute paths to companion binaries. Auto-resolved next to the backend binary
# (bin/) when unset; override only if laid out differently.
# SYSTEM_CLAUDE_BIN=/home/claude/.local/bin/claude
# SYSTEM_RUNNER_BIN=/path/to/bin/session-runner
# SYSTEM_RAG_MCP_BIN=/path/to/bin/rag-mcp
# SYSTEM_TOOLS_MCP_BIN=/path/to/bin/tools-mcp
# SYSTEM_ASK_MCP_BIN=/path/to/bin/ask-mcp

# --- Session behaviour ------------------------------------------------------
SYSTEM_PERMISSION_MODE=bypassPermissions   # new-session permission mode
SYSTEM_MODEL=opus                          # model alias forced for sessions
SYSTEM_MAX_TURNS=40                         # autonomous hand-back: max turns
SYSTEM_INACTIVITY_SECONDS=180              # autonomous hand-back: idle timeout
# SYSTEM_SESSION_MEMORY_MAX=2G              # per-session cgroup memory cap (systemd)
# SYSTEM_SESSION_CPU_QUOTA=200%             # per-session cgroup CPU cap (systemd)

# --- Authentication (OIDC / PocketID) ---------------------------------------
# Auth is OFF until SYSTEM_OIDC_ISSUER is set. Once set, CLIENT_ID, REDIRECT_URL
# and SESSION_SECRET are REQUIRED — the backend refuses to start without them.
# SYSTEM_OIDC_ISSUER=https://id.example.com
# SYSTEM_OIDC_CLIENT_ID=claude-hub
# SYSTEM_OIDC_CLIENT_SECRET=__GENERATE_ME__
# SYSTEM_OIDC_REDIRECT_URL=https://claude-hub.example.com/auth/callback
# Allowlists (comma-separated). Empty => any authenticated user is allowed.
# SYSTEM_AUTH_ALLOWED_SUBS=
# SYSTEM_AUTH_ALLOWED_EMAILS=admin@example.com
# HMAC key signing the session cookie. MUST be stable across restarts and secret.
# Generate e.g.: openssl rand -base64 48
# SYSTEM_SESSION_SECRET=__GENERATE_ME__

# --- Secrets at rest --------------------------------------------------------
# AES-256 key (base64, 32 bytes) encrypting connector credentials in the DB.
# When unset, a key file is minted at $SYSTEM_DATA_DIR/secret.key (0600) on first
# boot. Provide explicitly to control rotation. Generate: openssl rand -base64 32
# SYSTEM_SECRET_KEY=__GENERATE_ME__

# Token gating the loopback RAG/tools/ask endpoints. Auto-minted to
# $SYSTEM_DATA_DIR/loopback.token (0600) on first boot; override only if needed.
# SYSTEM_LOOPBACK_TOKEN=

# --- External services ------------------------------------------------------
# Local Ollama (embeddings + supervision). "host:port" is accepted (scheme added).
OLLAMA_HOST=127.0.0.1:11434
# Embedding model the RAG indexer asks Ollama for. Must be a model that is pulled
# locally. Defaults to nomic-embed-text (light, CPU-friendly).
# OLLAMA_EMBED_MODEL=nomic-embed-text

# RAG embeddings provider. Without it documents stay "pending" (no vectors).
# VOYAGE_API_KEY=__GENERATE_ME__

# Docker Engine endpoint for Sandbox/Live environments (unix:// only).
SYSTEM_DOCKER_HOST=unix:///var/run/docker.sock

# rrdtool CLI for host/Claude metrics historisation, and sampling interval (s).
SYSTEM_RRDTOOL_BIN=rrdtool
SYSTEM_HOST_SAMPLE_SECONDS=30

# --- Claude subscription / usage meter --------------------------------------
# claude CLI OAuth credentials file (read to report subscription usage).
SYSTEM_CLAUDE_CREDENTIALS=/home/claude/.claude/.credentials.json
# Claude Code OAuth token endpoint + public client id (override only if upstream
# changes). The client id below is the public Claude Code client, not a secret.
SYSTEM_OAUTH_TOKEN_URL=https://console.anthropic.com/v1/oauth/token
SYSTEM_OAUTH_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e
